# Free NVIDIA Build / NIM API key — https://build.nvidia.com/settings
NVIDIA_API_KEY=

# Fast simultaneous MT (Riva Translate 4B) — live captions
NVIDIA_MT_MODEL=nvidia/riva-translate-4b-instruct-v2

# Slow LLM — sermon memory, verse revision, summary (not on the live path)
NVIDIA_LLM_MODEL=stepfun-ai/step-5-preview
# Legacy alias still accepted:
# NVIDIA_MODEL=stepfun-ai/step-5-preview

# Optional DeepL (paid/free key)
# DEEPL_API_KEY=

# Optional MyMemory email for higher free quota
# MYMEMORY_EMAIL=you@example.com

# Local streaming ASR (WhisperLiveKit). Needs `wlk` on PATH.
# Without it, the booth stays on Chrome Web Speech.
# ASR_BACKEND=whisperlivekit
# WLK_MODEL=small
# WLK_LANGUAGE=pt
# WLK_PORT=8000

# Local NLLB 600M for Persian, Urdu, and when Riva has no draft.
# auto = start if python3 exists. First run downloads the model.
# NLLB_ENABLED=auto
# NLLB_CT2_DIR=/path/to/ctranslate2-model
